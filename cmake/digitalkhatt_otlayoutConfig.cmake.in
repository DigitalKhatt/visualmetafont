include(CMakeFindDependencyMacro)

find_dependency(Clipper2 CONFIG)

get_filename_component(_digitalkhatt_otlayout_config
  "${CMAKE_CURRENT_LIST_FILE}" REALPATH)
get_filename_component(_digitalkhatt_otlayout_config_dir
  "${_digitalkhatt_otlayout_config}" DIRECTORY)
include("${_digitalkhatt_otlayout_config_dir}/digitalkhatt_otlayoutTargets.cmake")
unset(_digitalkhatt_otlayout_config)
unset(_digitalkhatt_otlayout_config_dir)
