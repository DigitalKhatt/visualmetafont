cmake_minimum_required(VERSION 3.24)

set(test_dir "@CMAKE_CURRENT_BINARY_DIR@/package-test/${config}")
set(stage "${test_dir}/stage")
set(prefix "${test_dir}/relocated")
set(build_dir "${test_dir}/font-build")
file(REMOVE_RECURSE "${stage}" "${prefix}" "${build_dir}")
if(config)
  set(config_option --config "${config}")
endif()

# Install only the engine subtree, including its fetched dependencies. The
# developer workspace can also contain font projects with their own installers.
execute_process(COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_CURRENT_BINARY_DIR@"
  ${config_option} --prefix "${stage}" OUTPUT_QUIET COMMAND_ERROR_IS_FATAL ANY)
file(RENAME "${stage}" "${prefix}")
if(NOT EXISTS "${prefix}/@package_dir@/digitalkhatt_otlayoutConfig.cmake")
  message(FATAL_ERROR "The relocated installation is missing the engine package")
endif()

set(generator -G "@CMAKE_GENERATOR@")
if(NOT "@CMAKE_GENERATOR_PLATFORM@" STREQUAL "")
  list(APPEND generator -A "@CMAKE_GENERATOR_PLATFORM@")
endif()
if(NOT "@CMAKE_GENERATOR_TOOLSET@" STREQUAL "")
  list(APPEND generator -T "@CMAKE_GENERATOR_TOOLSET@")
endif()
set(dependency_dirs "@package_test_dependency_dirs@")
if(NOT "@CMAKE_TOOLCHAIN_FILE@" STREQUAL "")
  list(APPEND generator "-DCMAKE_TOOLCHAIN_FILE=@CMAKE_TOOLCHAIN_FILE@")
endif()
execute_process(COMMAND "@CMAKE_COMMAND@" -S "@package_test_font@" -B "${build_dir}" ${generator}
  "-DCMAKE_CXX_COMPILER=@CMAKE_CXX_COMPILER@" "-DCMAKE_BUILD_TYPE=${config}"
  "-DCMAKE_OSX_ARCHITECTURES=@CMAKE_OSX_ARCHITECTURES@" "-DCMAKE_OSX_SYSROOT=@CMAKE_OSX_SYSROOT@"
  "-DCMAKE_OSX_DEPLOYMENT_TARGET=@CMAKE_OSX_DEPLOYMENT_TARGET@"
  "-DCMAKE_PREFIX_PATH=${prefix};@CMAKE_PREFIX_PATH@"
  "-Ddigitalkhatt_otlayout_DIR=${prefix}/@package_dir@" ${dependency_dirs}
  -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF
  -DBUILD_TESTING=OFF COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "@CMAKE_COMMAND@" --build "${build_dir}" ${config_option}
  COMMAND_ERROR_IS_FATAL ANY)
