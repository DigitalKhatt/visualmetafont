if(TARGET digitalkhatt::otlayout)
  return()
endif()
include(CMakeFindDependencyMacro)
if(@find_clipper2@)
  find_dependency(Clipper2 1.5.4 CONFIG)
endif()
if(@find_glaze@)
  find_dependency(glaze 7.5.0 CONFIG)
endif()
if(@find_pcre2@)
  find_dependency(PCRE2 10.47 CONFIG COMPONENTS 16BIT)
endif()

get_filename_component(_digitalkhatt_config "${CMAKE_CURRENT_LIST_FILE}" REALPATH)
get_filename_component(_digitalkhatt_config_dir "${_digitalkhatt_config}" DIRECTORY)
include("${_digitalkhatt_config_dir}/digitalkhatt_otlayoutTargets.cmake")
unset(_digitalkhatt_config)
unset(_digitalkhatt_config_dir)
add_library(digitalkhatt::otlayout ALIAS @imported_otlayout@)
if(NOT TARGET digitalkhatt_otlayout)
  add_library(digitalkhatt_otlayout ALIAS @imported_otlayout@)
endif()
